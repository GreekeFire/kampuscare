# Copy to .env and paste your key. Never commit .env.
# Google Gemini (free key: https://aistudio.google.com/apikey)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model is overloaded (503) or rate-limited (429)
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Backup: Groq (free key: https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

